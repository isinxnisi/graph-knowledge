# Independent ops candidate: no Next build, web image, member migration or compatibility mount.
FROM node:24.21.0-bookworm-slim AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
FROM node:24.21.0-bookworm-slim
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY lib ./lib
COPY neo4j ./neo4j
COPY scripts/public-kg.ts scripts/publication-runtime.ts scripts/publication-backup-plan.ts ./scripts/
ENV NODE_ENV=production GRAPH_DATASET=public-kg GRAPH_DEPLOYMENT=production TSX_DISABLE_CACHE=1
USER node
ENTRYPOINT ["node", "--import", "tsx"]
CMD ["scripts/publication-runtime.ts", "capabilities"]
