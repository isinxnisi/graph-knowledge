#!/usr/bin/python3 -I
# Installation candidate only. No configuration overrides, shell, env preservation or upload execution.
import importlib.util
import os
from pathlib import Path
import stat
import sys

try:
    if os.geteuid() != 0 or len(sys.argv) != 3: raise ValueError('Fixed root entry required')
    root = Path('/usr/local/lib/plunode-publication')
    for path in [root, *root.parents]:
        st = path.lstat()
        if path.is_symlink() or st.st_uid != 0 or st.st_mode & 0o022: raise ValueError('Untrusted installation')
    for name in ['publication-executor.py','publication-policy.py','publication-cycle.py','verify-publication.py','publication-exclusion.py','publication-sign.py']:
        path=root/name; st=path.lstat()
        if path.is_symlink() or not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022: raise ValueError('Untrusted program')
    os.environ.clear(); os.environ.update(PATH='/usr/bin:/bin',LANG='C.UTF-8',HOME='/nonexistent')
    os.umask(0o077)
    spec=importlib.util.spec_from_file_location('installed_publication',root/'publication-executor.py')
    module=importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
    sys.exit(module.root_entry())
except Exception:
    print('{"error":"publication-installation-or-request-rejected"}'); sys.exit(1)
