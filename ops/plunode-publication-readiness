#!/usr/bin/python3 -I
"""Temporary read-only boundary probe. Existing gate, real public plan, no execute/apply capability."""
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys

PRODUCTION=Path('/var/lib/plunode-publication')
ROOT=PRODUCTION/'readiness'
CODE=Path('/usr/local/lib/plunode-publication')
ALLOWED={'arm','preflight','status','cancel','finish','audit','cleanup'}
READ_ONLY_STAGES={'image','validate','observe','plan'}
FILES={'ops/plunode-publication','ops/publication-ssh.py','scripts/publication-executor.py','scripts/publication-exclusion.py',
    'scripts/publication-policy.py','scripts/publication-cycle.py','scripts/publication-sign.py','scripts/verify-publication.py',
    'scripts/publication-notify.py','ops/plunode-publication-readiness','vendor/gh'}
SUDOERS=Path('/etc/sudoers.d/plunode-publication-readiness')
SUDO_TEXT='plunode-publish ALL=(root) NOPASSWD: NOSETENV: /usr/local/sbin/plunode-publication-readiness\n'

def require(value):
    if not value:raise ValueError('Fixed read-only readiness boundary differs')
def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def read(p):return json.loads(p.read_bytes())
def trusted(p):
    st=p.lstat();require(not p.is_symlink() and st.st_uid==0 and not st.st_mode&0o022
        and (stat.S_ISDIR(st.st_mode) or stat.S_ISREG(st.st_mode) and st.st_nlink==1))

def target(relative):
    if relative.startswith('ops/plunode-'):return Path('/usr/local/sbin')/Path(relative).name
    return CODE/Path(relative).name

def readonly_call(backend,stage,payload):
    require(stage in READ_ONLY_STAGES)
    return backend(stage,payload)

def main():
    require(os.geteuid()==0 and len(sys.argv)==3)
    command,nonce=sys.argv[1:];require(command in ALLOWED)
    require(re.fullmatch(r'[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}',nonce))
    os.environ.clear();os.environ.update(PATH='/usr/bin:/bin',LANG='C.UTF-8',HOME='/nonexistent');os.umask(0o077)
    for p in [CODE,*CODE.parents,PRODUCTION,PRODUCTION/'trusted',ROOT,ROOT/'trusted']:trusted(p)
    trusted(PRODUCTION/'trusted/program-manifest.json')
    manifest=read(PRODUCTION/'trusted/program-manifest.json')
    require(re.fullmatch('[a-f0-9]{40}',manifest['sourceCommit']) and set(manifest['files'])==FILES)
    for relative,checksum in manifest['files'].items():
        p=target(relative);trusted(p);require(sha(p)==checksum)
    trusted(PRODUCTION/'trusted/config.json');production=read(PRODUCTION/'trusted/config.json')
    require(production['deploymentEnabled'] is False and all(production[k]==v for k,v in manifest['configBindings'].items())
        and production['operatorDigest'] in [manifest['operatorConfigId'],manifest['operatorManifestId']])
    cfg=read(ROOT/'trusted/config.json')
    require(cfg['readOnlyProbe'] is True and cfg['workerId']=='publication-readiness'
        and cfg['workerCodeCommit']==production['workerCodeCommit']
        and cfg['operatorDigest']==production['operatorDigest']
        and all(cfg[k]==production[k] for k in ['network','neo4jUri','neo4jDatabase','attesterKeySha256']))
    spec=importlib.util.spec_from_file_location('fixed_readiness_executor',CODE/'publication-executor.py')
    e=importlib.util.module_from_spec(spec);spec.loader.exec_module(e)
    class Backend(e.DockerBackend):
        def call(self,stage,payload):return readonly_call(super().call,stage,payload)
    gate=e.Gate(ROOT,False);gate.common=ROOT/'operation.lock';gate.backend=Backend(ROOT,cfg)
    require(not gate.reservations()['nonces'] and not gate.reservations()['releases'])
    if command=='audit':
        event=read(ROOT/'outbox'/(nonce+'-readiness.json'));require(event['productionEnabled'] is False and event['productionApplyCalls']==0)
        result=subprocess.run(['/usr/sbin/runuser','-u','plunode-audit','--','/usr/bin/python3','-I',str(CODE/'publication-notify.py'),'--readiness',nonce],capture_output=True,env=e.CLEAN_ENV,timeout=45)
        require(result.returncode==0);result=json.loads(result.stdout)
    elif command=='cleanup':
        with e.locked(gate.common):
            value=gate.exclusion.read();require(value['active'] is None and all(t['phase']=='finished' for t in value['tickets'].values()))
            trusted(SUDOERS);require(SUDOERS.read_text()==SUDO_TEXT);SUDOERS.unlink()
            result={'readOnly':True,'temporarySudoRemoved':True,'productionEnabled':False,'applyCalls':0,'journalsPreserved':True}
            e.durable(ROOT/'outbox/cleanup.json',result);(ROOT/'outbox/cleanup.json').chmod(0o644)
    else:
        result=gate.run(command,nonce,e.exchange_stdio)
        if command=='finish' and result['phase']=='finished':
            state=read(gate.job_path(nonce));request=state.get('request')
            if request:
                require(not gate.reservations()['nonces'])
                event={k:request[k] for k in ['receiptSetSha256','baseRelease','baseRevision','operatorDigest','planSha256']}
                event.update(nonce=nonce,phase='read-only-readiness-verified',readOnly=True,productionEnabled=False,productionApplyCalls=0,sourceCommit=manifest['sourceCommit'])
                path=ROOT/'outbox'/(nonce+'-readiness.json');e.durable(path,event);path.chmod(0o644)
    print(json.dumps({'result':result}),flush=True)

if __name__=='__main__':
    try:main()
    except Exception:
        print('{"error":"read-only-readiness-stopped","applyAuthorized":false}',flush=True);sys.exit(1)
