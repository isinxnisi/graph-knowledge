[Unit]
Description=Plunode management Cloudflare Tunnel
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/cloudflared/plunode-admin.token

[Service]
Type=simple
DynamicUser=yes
LoadCredential=tunnel-token:/etc/cloudflared/plunode-admin.token
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel --protocol http2 --metrics 127.0.0.1:20252 run --token-file %d/tunnel-token
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
MemoryMax=192M
CPUQuota=50%
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
