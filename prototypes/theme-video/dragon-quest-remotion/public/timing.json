  "scenes": [
    {
      "id": "door",
      "start": 0,
      "end": 9.5,
      "cues": [
        {
          "start": 1.92,
          "end": 4.293,
          "text": "さいしょの扉が、開きません。"
        },
        {
          "start": 5.1,
          "end": 7.988,
          "text": "世界を救うのは、もう少しあとです。"
        }
      ]
    },
    {
      "id": "memory",
      "start": 9.5,
      "end": 19.5,
      "cues": [
        {
          "start": 10.05,
          "end": 14.61,
          "text": "1986年、ファミコンの\n初代『ドラゴンクエスト』。"
        },
        {
          "start": 14.69,
          "end": 17.687,
          "text": "冒険は、王さまの部屋から始まります。"
        }
      ]
    },
    {
      "id": "talk",
      "start": 19.5,
      "end": 36.5,
      "cues": [
        {
          "start": 20.04,
          "end": 23.748,
          "text": "Ａを押すと、部屋の上に、\nできることが並びます。"
        },
        {
          "start": 24.5,
          "end": 27.779,
          "text": "「はなす」を選ぶと、\n今度は、どっちに？"
        },
        {
          "start": 29.0,
          "end": 31.636,
          "text": "左にいる人には、左を選ぶ。"
        },
        {
          "start": 32.6,
          "end": 35.562,
          "text": "窓が一枚ずつ、次の手を教えます。"
        }
      ]
    },
    {
      "id": "chest",
      "start": 36.5,
      "end": 53,
      "cues": [
        {
          "start": 37.05,
          "end": 40.653,
          "text": "宝箱もあります。となりで「とる」。\n……取れません。"
        },
        {
          "start": 42.7,
          "end": 46.442,
          "text": "説明書には、箱の上に乗ってから、\nとあります。"
        },
        {
          "start": 48.2,
          "end": 50.518,
          "text": "乗ってみる。今度は取れました。"
        }
      ]
    },
    {
      "id": "exit",
      "start": 53,
      "end": 64,
      "cues": [
        {
          "start": 54.2,
          "end": 56.99,
          "text": "手に入れたカギを持って、\n「とびら」を選ぶ。"
        },
        {
          "start": 59.1,
          "end": 61.253,
          "text": "やっと、部屋の外へ。"
        }
      ]
    },
    {
      "id": "sources",
      "start": 64,
      "end": 80,
      "cues": [
        {
          "start": 64.75,
          "end": 67.118,
          "text": "生みの親の堀井雄二さんは、"
        },
        {
          "start": 67.7,
          "end": 71.969,
          "text": "部屋を出るまでに操作を覚えられるようにした、\nと振り返っています。"
        },
        {
          "start": 74.1,
          "end": 77.475,
          "text": "冒険の入り口は、小さな練習場でした。"
        }
      ]
    },
    {
      "id": "end",
      "start": 80,
      "end": 85.41666666666667,
      "cues": []
    }
  ]
