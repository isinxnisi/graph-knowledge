{
  "name": "graph-knowledge",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "npm run vocabulary:check && eslint .",
    "test": "npm run vocabulary:check && vitest run tests/domain.test.ts tests/http.test.ts tests/ui-state.test.tsx tests/pilot.test.ts tests/vocabulary.test.ts tests/contribution.test.ts tests/science.test.ts",
    "test:integration": "vitest run tests/seed.integration.test.ts tests/api.integration.test.ts --no-file-parallelism",
    "fixture:validate": "tsx scripts/validate-fixture.ts",
    "db:constraints": "tsx scripts/constraints.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test:api": "vitest run tests/api.integration.test.ts --no-file-parallelism",
    "test:e2e": "playwright test",
    "pilot:prepare": "tsx scripts/prepare-pilot.ts",
    "pilot:validate": "tsx scripts/prepare-pilot.ts --check",
    "pilot:seed": "tsx scripts/pilot.ts seed",
    "pilot:dev": "tsx scripts/pilot.ts dev",
    "pilot:build": "tsx scripts/pilot.ts build",
    "pilot:e2e": "playwright test --config=playwright.pilot.config.ts",
    "pilot:integration": "vitest run tests/pilot.integration.test.ts --no-file-parallelism",
    "vocabulary:check": "tsx scripts/check-vocabulary.ts",
    "pilot:v2:prepare": "tsx scripts/prepare-pilot-v2.ts",
    "pilot:v2:validate": "tsx scripts/prepare-pilot-v2.ts --check",
    "pilot:v2:seed": "tsx scripts/pilot-v2.ts seed",
    "pilot:v2:dev": "tsx scripts/pilot-v2.ts dev",
    "pilot:v2:build": "tsx scripts/pilot-v2.ts build",
    "pilot:v2:integration": "vitest run tests/contribution.integration.test.ts --no-file-parallelism",
    "pilot:v2:e2e": "playwright test --config=playwright.pilot-v2.config.ts",
    "science:prepare": "tsx scripts/prepare-science.ts",
    "science:validate": "tsx scripts/prepare-science.ts --check",
    "science:seed": "tsx scripts/science.ts seed",
    "science:dev": "tsx scripts/science.ts dev",
    "science:build": "tsx scripts/science.ts build",
    "science:integration": "vitest run tests/science.integration.test.ts --no-file-parallelism",
    "science:e2e": "playwright test --config=playwright.science.config.ts"
  },
  "dependencies": {
    "cytoscape": "3.34.3",
    "neo4j-driver": "6.2.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "type": "module",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/cytoscape": "3.21.9",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
