{
  "name": "graph-knowledge",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/domain.test.ts tests/http.test.ts tests/ui-state.test.tsx",
    "test:integration": "vitest run tests/seed.integration.test.ts tests/api.integration.test.ts --no-file-parallelism",
    "fixture:validate": "tsx scripts/validate-fixture.ts",
    "db:constraints": "tsx scripts/constraints.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test:api": "vitest run tests/api.integration.test.ts --no-file-parallelism",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "cytoscape": "3.34.3",
    "neo4j-driver": "6.2.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "type": "module",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/cytoscape": "3.21.9",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
