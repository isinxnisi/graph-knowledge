[
  {
    "id": "reading-20261110:webb:sunshield-background",
    "target": {
      "id": "u3:fbaa9ee12f288cfa:record:5266d210bef739fd01c7",
      "revision": 1
    },
    "role": "background",
    "english": "The sunshield was folded to fit inside the rocket. Unfolding it in space was part of preparing Webb for observation.",
    "content": {
      "kind": "note",
      "subjectId": "u3:fbaa9ee12f288cfa:entity:e7a84d267f62548ef726",
      "assertion": "打上げ時はロケットに収めるため折り畳まれていた遮熱膜を、宇宙で広げる工程。観測を始める前に必要な準備だった。",
      "textLanguages": {
        "assertion": {
          "tag": "ja",
          "basis": "declared"
        }
      },
      "aboutRecord": {
        "id": "u3:fbaa9ee12f288cfa:record:5266d210bef739fd01c7",
        "revision": 1
      },
