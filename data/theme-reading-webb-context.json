          "excerpt": "",
          "stance": "support"
        }
      ]
    }
  },
  {
    "id": "reading-20261110:webb:mid-booms-context",
    "target": {
      "id": "u3:fbaa9ee12f288cfa:record:01b09a17397497ff7089",
      "revision": 1
    },
    "role": "background",
    "english": "The booms pulled the folded membranes out sideways. Tensioning the five layers into their final shape followed.",
    "content": {
      "kind": "note",
      "subjectId": "u3:fbaa9ee12f288cfa:entity:e7a84d267f62548ef726",
      "assertion": "ブームは折り畳まれた膜を横へ引き出す役割を持つ。その後、5枚の膜を張り、最終的な形に整える工程が続く。",
      "textLanguages": {
        "assertion": {
          "tag": "ja",
          "basis": "declared"
        }
      },
