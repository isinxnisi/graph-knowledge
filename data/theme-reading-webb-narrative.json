            "revision": 1
          },
          "locator": "Paragraph beginning \"The world’s largest and most complex\", RELEASE 22-002",
          "excerpt": "",
          "stance": "support"
        }
      ]
    }
  },
  {
    "id": "reading-20261110:webb:mid-booms-context",
    "target": {
      "id": "u3:fbaa9ee12f288cfa:record:01b09a17397497ff7089",
      "revision": 1
    },
    "role": "background",
    "english": "Two mid-booms pulled the folded membranes out sideways. Each layer was then tensioned to give the five-layer sunshield its final shape.",
    "content": {
      "kind": "note",
      "subjectId": "u3:fbaa9ee12f288cfa:entity:e7a84d267f62548ef726",
      "assertion": "畳まれた膜を左右へ引き出すのが、二つのミッドブーム。そのあと一枚ずつ膜を張り、5層の遮熱膜を最終的な形に整える。",
      "textLanguages": {
        "assertion": {
          "tag": "ja",
          "basis": "declared"
        }
      },
      "aboutRecord": {
        "id": "u3:fbaa9ee12f288cfa:record:01b09a17397497ff7089",
