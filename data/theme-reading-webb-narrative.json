  {
    "id": "reading-20261110:webb:launch-purpose",
    "target": {
      "id": "u3:fbaa9ee12f288cfa:record:6164c16405ffad14780c",
      "revision": 1
    },
    "role": "importance",
    "english": "A folded telescope left Earth. Its destination was a view of light from the first stars and galaxies. Deployment and preparations in space would turn it into a working observatory.",
    "content": {
      "kind": "note",
      "subjectId": "u3:fbaa9ee12f288cfa:entity:e7a84d267f62548ef726",
      "assertion": "折り畳まれた望遠鏡が、地上を離れた。目指すのは、最初の星や銀河が生まれたころの光。ここから宇宙で機体をひらき、観測できる状態へ整えていく。",
      "textLanguages": {
        "assertion": {
          "tag": "ja",
          "basis": "declared"
        }
      },
