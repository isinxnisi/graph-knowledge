[
  {
    "id": "reading-20261110:webb:sunshield-background",
    "target": {
      "id": "u3:fbaa9ee12f288cfa:record:5266d210bef739fd01c7",
      "revision": 1
    },
    "role": "background",
    "english": "A tennis-court-sized sunshield could not fit unfolded inside the rocket. It travelled folded, then was opened remotely in space.",
    "content": {
      "kind": "note",
      "subjectId": "u3:fbaa9ee12f288cfa:entity:e7a84d267f62548ef726",
      "assertion": "テニスコートほどの遮熱膜を、そのままロケットに積むことはできない。折り畳んで打ち上げ、宇宙で遠隔操作により広げた。",
      "textLanguages": {
        "assertion": {
          "tag": "ja",
          "basis": "declared"
        }
      },
      "aboutRecord": {
        "id": "u3:fbaa9ee12f288cfa:record:5266d210bef739fd01c7",
        "revision": 1
      },
